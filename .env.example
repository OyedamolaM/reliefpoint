# Server-only. Copy to .env.local; never commit credentials.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PAYSTACK_SECRET_KEY=
BREVO_API_KEY=
WORKER_SECRET=
# Optional server-only owner recovery account. Both must match a verified Supabase user.
SUPPORT_USER_ID=
SUPPORT_EMAIL=
